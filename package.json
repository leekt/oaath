{
  "name": "@oaath/workspace",
  "version": "0.0.0",
  "private": true,
  "description": "OAuth for scoped smart-account authority.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "build": "pnpm -r build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome check . --diagnostic-level=error",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check:public-surface": "node scripts/check-public-surface.mjs",
    "smoke:browser": "node scripts/smoke-packed-browser.mjs",
    "smoke:server": "node scripts/smoke-packed-server.mjs",
    "smoke:all-chain": "node scripts/smoke-all-chain-anvil.mjs",
    "smoke": "pnpm smoke:browser && pnpm smoke:server",
    "changeset": "changeset",
    "release:status": "changeset status",
    "release:version": "changeset version",
    "release:publish": "changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@changesets/cli": "^2.29.8",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  }
}
