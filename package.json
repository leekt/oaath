{
  "name": "@leekt/ogp",
  "version": "0.0.0",
  "private": true,
  "description": "OAuth for scoped smart-account authority.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/ogp.git"
  },
  "bugs": {
    "url": "https://github.com/leekt/ogp/issues"
  },
  "homepage": "https://github.com/leekt/ogp#readme",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "preinstall": "node scripts/check-package-manager.mjs",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "node scripts/check-package-boundary.mjs && biome check . --diagnostic-level=error",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "pack:check": "pnpm build && pnpm pack --pack-destination .artifacts",
    "check": "node scripts/run-gate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "fast-check": "^4.9.0",
    "tsdown": "^0.22.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "viem": "2.55.8"
  }
}
