<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Optional paid-team template. The target does not attach this file by
	     default, so Personal Teams can provision the pull-inbox demo. Paid-team
	     dev installs receive SANDBOX tokens for api.sandbox.push.apple.com. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
