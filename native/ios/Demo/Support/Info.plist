<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  DEV-ONLY ATS EXCEPTION — DO NOT SHIP.
	  The demo relay (examples/phone) serves plain http on the Mac's LAN
	  address, so App Transport Security must be disabled for this demo build.
	  A real deployment serves https and deletes this key entirely.
	-->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>Scan the one-time OAAth pairing QR code shown by your browser.</string>
	<key>NSFaceIDUsageDescription</key>
	<string>Confirm an OAAth owner-signing approval with your protected owner key.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the OAAth demo relay running on your Mac.</string>
	<!--
	  The pairing deep link: examples/phone prints
	  oaath-demo://pair?relay=...&code=... as a QR code and copyable text.
	  Scanning in-app, using the system Camera, or tapping it fills the pairing
	  screen; pairing itself stays an explicit button.
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>org.oaath.owner-phone-demo.pairing</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>oaath-demo</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
