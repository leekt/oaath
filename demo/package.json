{
  "name": "@oaath/demo",
  "version": "0.0.0",
  "private": true,
  "description": "The hosted OAAth demo dapp and its Cloudflare Worker. Never a published package.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy:check": "vite build && bunx wrangler@4.147.0 deploy --dry-run",
    "test:e2e": "vite build && bun run --filter @oaath/portal build && OAATH_DEMO_E2E=1 vitest run"
  },
  "dependencies": {
    "@oaath/automation": "workspace:*",
    "@oaath/sdk": "workspace:*",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@oaath/automation-server": "workspace:*",
    "@types/node": "22.13.0",
    "puppeteer-core": "25.5.0",
    "viem": "2.55.8",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
