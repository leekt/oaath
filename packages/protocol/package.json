{
  "name": "@oaath/protocol",
  "version": "0.3.4",
  "description": "IO-free OAAth wire, durable contracts, and Kernel v4 signing profiles.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/protocol"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "oaath-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --platform neutral",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:publish": "bun publish --access public --tolerate-republish",
    "release:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "cetane": "0.0.4",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "fast-check": "^4.9.0",
    "viem": "2.55.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
