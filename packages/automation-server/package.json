{
  "name": "@oaath/automation-server",
  "version": "0.3.5",
  "description": "Self-hostable OAAth automation service: HTTP API, scheduler and executor over PostgreSQL.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/automation-server"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "oaath-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "bin": {
    "oaath-automation": "./dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/cli.ts --platform node",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:publish": "bun publish --access public --tolerate-republish",
    "release:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@oaath/automation": "workspace:*",
    "@oaath/protocol": "workspace:*",
    "@oaath/sdk": "workspace:*",
    "cetane": "0.0.4",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/pg": "8.15.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
