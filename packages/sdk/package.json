{
  "name": "@oaath/sdk",
  "version": "0.3.5",
  "description": "OAAth browser client and Kernel/ZeroDev runtime.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "oaath-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./kernel": {
      "oaath-source": {
        "types": "./src/kernel.ts",
        "default": "./src/kernel.ts"
      },
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    },
    "./advanced": {
      "oaath-source": {
        "types": "./src/advanced.ts",
        "default": "./src/advanced.ts"
      },
      "types": "./dist/advanced.d.ts",
      "default": "./dist/advanced.js"
    },
    "./persistence": {
      "oaath-source": {
        "types": "./src/persistence.ts",
        "default": "./src/persistence.ts"
      },
      "types": "./dist/persistence.d.ts",
      "default": "./dist/persistence.js"
    },
    "./testing": {
      "oaath-source": {
        "types": "./src/testing.ts",
        "default": "./src/testing.ts"
      },
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./cetane": {
      "oaath-source": {
        "types": "./src/cetane.ts",
        "default": "./src/cetane.ts"
      },
      "types": "./dist/cetane.d.ts",
      "default": "./dist/cetane.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "check:rate-limit-artifact": "node scripts/check-rate-limit-artifact.mjs",
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:anvil": "OAATH_REQUIRE_ANVIL=1 vitest run test/kernel-v4.anvil.test.ts test/kernel-v33.anvil.test.ts test/kernel-composition.anvil.test.ts test/all-chain.anvil.test.ts test/provider-eip5792.anvil.test.ts test/cetane-chain-ports.anvil.test.ts test/portal-roots.anvil.test.ts test/owner-operation.anvil.test.ts test/oauth-grants.anvil.test.ts",
    "test:provider-anvil": "OAATH_REQUIRE_ANVIL=1 vitest run test/provider-eip5792.anvil.test.ts",
    "lint": "node scripts/check-package-boundary.mjs",
    "release:publish": "bun publish --access public --tolerate-republish",
    "release:check": "bun pm pack --dry-run"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@oaath/testing": "workspace:*",
    "@types/node": "22.13.0",
    "fake-indexeddb": "6.2.5",
    "viem": "2.55.8"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@oaath/protocol": "workspace:*",
    "cetane": "0.0.4",
    "@noble/hashes": "1.8.0",
    "jose": "6.2.12"
  },
  "publishConfig": {
    "access": "public"
  }
}
