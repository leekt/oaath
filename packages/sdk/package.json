{
  "name": "@oaath/sdk",
  "version": "0.0.0",
  "description": "OAAth browser client and Kernel/ZeroDev runtime.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./kernel": {
      "types": "./src/kernel.ts",
      "default": "./src/kernel.ts"
    },
    "./advanced": {
      "types": "./src/advanced.ts",
      "default": "./src/advanced.ts"
    },
    "./persistence": {
      "types": "./src/persistence.ts",
      "default": "./src/persistence.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "default": "./src/testing.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./kernel": {
        "types": "./dist/kernel.d.ts",
        "default": "./dist/kernel.js"
      },
      "./advanced": {
        "types": "./dist/advanced.d.ts",
        "default": "./dist/advanced.js"
      },
      "./persistence": {
        "types": "./dist/persistence.d.ts",
        "default": "./dist/persistence.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:anvil": "OAATH_REQUIRE_ANVIL=1 vitest run test/kernel-v4.anvil.test.ts test/kernel-composition.anvil.test.ts test/all-chain.anvil.test.ts",
    "lint": "node scripts/check-package-boundary.mjs"
  },
  "devDependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@oaath/server": "workspace:*",
    "@oaath/testing": "workspace:*",
    "@types/node": "22.13.0",
    "fake-indexeddb": "6.2.5"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@oaath/protocol": "workspace:*",
    "viem": "2.55.8"
  }
}
