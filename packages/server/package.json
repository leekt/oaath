{
  "name": "@oaath/server",
  "version": "0.1.0",
  "description": "OAAth deployable relay and PostgreSQL boundary.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./postgres": {
      "types": "./src/postgres.ts",
      "node": "./src/postgres.ts"
    },
    "./native": {
      "types": "./src/native.ts",
      "default": "./src/native.ts"
    },
    "./apns": {
      "types": "./src/apns.ts",
      "node": "./src/apns.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./postgres": {
        "types": "./dist/postgres.d.ts",
        "node": "./dist/postgres.js"
      },
      "./native": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "./apns": {
        "types": "./dist/apns.d.ts",
        "node": "./dist/apns.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "OAATH_REQUIRE_POSTGRES=1 vitest run test/postgres.test.ts test/restart.test.ts"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "2.2.0",
    "@oaath/protocol": "workspace:*",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/pg": "8.20.3"
  }
}
