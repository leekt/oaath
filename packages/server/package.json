{
  "name": "@oaath/server",
  "version": "0.3.4",
  "description": "OAAth deployable relay and PostgreSQL boundary.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "oaath-source": {
        "types": "./src/index.ts",
        "default": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./postgres": {
      "oaath-source": {
        "types": "./src/postgres.ts",
        "node": "./src/postgres.ts"
      },
      "types": "./dist/postgres.d.ts",
      "node": "./dist/postgres.js"
    },
    "./native": {
      "oaath-source": {
        "types": "./src/native.ts",
        "default": "./src/native.ts"
      },
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./apns": {
      "oaath-source": {
        "types": "./src/apns.ts",
        "node": "./src/apns.ts"
      },
      "types": "./dist/apns.d.ts",
      "node": "./dist/apns.js"
    },
    "./kernel": {
      "oaath-source": {
        "types": "./src/kernel.ts",
        "default": "./src/kernel.ts"
      },
      "types": "./dist/kernel.d.ts",
      "default": "./dist/kernel.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:postgres": "OAATH_REQUIRE_POSTGRES=1 vitest run test/postgres.test.ts test/restart.test.ts test/service-directory-postgres.test.ts test/revocation-service.test.ts test/revocation-executor.test.ts test/native-inbox.test.ts test/owner-device-authentication-postgres.test.ts",
    "release:publish": "bun publish --access public --tolerate-republish",
    "release:check": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@noble/curves": "1.9.1",
    "@noble/hashes": "2.2.0",
    "@oaath/protocol": "workspace:*",
    "pg": "8.22.0",
    "@oaath/sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/pg": "8.20.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
