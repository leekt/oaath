{
  "name": "@oaath/testing",
  "version": "0.3.4",
  "description": "OAAth deterministic fixtures and clean-consumer harnesses. Never a production dependency.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./anvil": {
      "oaath-source": {
        "types": "./src/anvil.ts",
        "node": "./src/anvil.ts"
      },
      "types": "./dist/anvil.d.ts",
      "node": "./dist/anvil.js"
    },
    ".": {
      "oaath-source": {
        "types": "./src/index.ts",
        "node": "./src/index.ts"
      },
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "release:publish": "bun publish --access public --tolerate-republish",
    "release:check": "bun pm pack --dry-run",
    "test:anvil": "OAATH_REQUIRE_ANVIL=1 vitest run test/anvil-owner.test.ts test/anvil-session.test.ts test/anvil-recovery.test.ts test/local-mode.anvil.test.ts test/anvil-lanes.test.ts"
  },
  "dependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@noble/curves": "1.9.1",
    "@oaath/protocol": "workspace:*",
    "@oaath/sdk": "workspace:*",
    "@oaath/server": "workspace:*",
    "fake-indexeddb": "6.2.5",
    "cetane": "file:../../vendor/cetane-0.0.2-9862f7c.tgz"
  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "viem": "2.55.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
