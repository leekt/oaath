{
  "name": "@oaath/testing",
  "version": "0.2.0",
  "description": "OAAth deterministic fixtures and clean-consumer harnesses. Never a production dependency.",
  "type": "module",
  "sideEffects": false,
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/leekt/oaath.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/leekt/oaath/issues"
  },
  "homepage": "https://github.com/leekt/oaath#readme",
  "engines": {
    "node": ">=22.13"
  },
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    "./anvil": {
      "types": "./src/anvil.ts",
      "node": "./src/anvil.ts"
    },
    ".": {
      "types": "./src/index.ts",
      "node": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      "./anvil": {
        "types": "./dist/anvil.d.ts",
        "node": "./dist/anvil.js"
      },
      ".": {
        "types": "./dist/index.d.ts",
        "node": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "pnpm build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@account-abstraction/contracts": "0.7.0",
    "@oaath/protocol": "workspace:*",
    "@oaath/sdk": "workspace:*",
    "@oaath/server": "workspace:*",
    "fake-indexeddb": "6.2.5",
    "viem": "2.55.8"
  },
  "devDependencies": {
    "@types/node": "22.13.0"
  }
}
