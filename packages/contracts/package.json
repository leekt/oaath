{
  "name": "@oaath/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "OAAth-owned Kernel policy contracts and deterministic deployment artifacts.",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "kernel:generate": "node scripts/kernel-artifact.mjs --write",
    "kernel:check": "node scripts/kernel-artifact.mjs --check",
    "artifact:check": "forge build && node scripts/artifact.mjs --check",
    "artifact:generate": "forge build && node scripts/artifact.mjs --write",
    "build": "forge build && node scripts/artifact.mjs --check",
    "lint": "forge fmt --check && node scripts/artifact.mjs --check",
    "test": "forge test",
    "webauthn:check": "node scripts/webauthn-artifact.mjs --check",
    "webauthn:generate": "node scripts/webauthn-artifact.mjs --write"
  },
  "devDependencies": {
    "viem": "2.55.8"
  }
}
