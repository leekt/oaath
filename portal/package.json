  },
  "devDependencies": {
    "@types/node": "22.13.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.1",
    "jose": "6.2.12",
    "puppeteer-core": "25.5.0",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
