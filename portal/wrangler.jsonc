{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  "name": "oaath-portal",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "oaath.taek.tech", "custom_domain": true }],
  // The Worker decides every route first; only it reads the built SPA.
  "assets": { "directory": "./dist", "binding": "ASSETS", "run_worker_first": true },
  "vpc_services": [
    {
      "binding": "RELAY",
      // Workers VPC service `oaath-relay`: 127.0.0.1:4315 on the OCI VM's loopback.
      "service_id": "01a115c3-9a1a-7141-8dc6-306a0311b266"
    }
  ],
  // Per-IP budget for `/rpc/421614`: 240 chain reads a minute. RPC_UPSTREAM_421614
  // (a secret) may replace the public Arbitrum Sepolia endpoint.
  "ratelimits": [
    { "name": "RPC_LIMIT", "namespace_id": "4216140", "simple": { "limit": 240, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
