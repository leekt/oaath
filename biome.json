{
  "$schema": "https://biomejs.dev/schemas/2.5.5/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/coverage",
      "!**/.artifacts",
      "!**/.build",
      "!packages/contracts/cache",
      "!packages/contracts/out",
      "!examples/dca/contracts/cache",
      "!examples/dca/contracts/out",
      "!relay/target",
      "!relay/fixtures"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
