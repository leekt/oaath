{
  "name": "@oaath/examples",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable OAAth examples. Documentation, never a published package.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "taek <leekt216@gmail.com>",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "check": "node check.mjs",
    "example:browser": "node --import ./support/workspace-typescript.mjs browser/run.mjs",
    "example:server": "node --import ./support/workspace-typescript.mjs server/run.mjs",
    "example:all-chain": "node --import ./support/workspace-typescript.mjs all-chain/run.mjs",
    "example:oauth-login": "node oauth-login/run.mjs",
