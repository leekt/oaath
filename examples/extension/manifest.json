{
  "manifest_version": 3,
  "name": "OAAth",
  "version": "0.1.0",
  "description": "Announces the OAAth Grant provider (EIP-6963) so any dapp executes through scoped session authority with zero integration.",
  "background": {
    "service_worker": "worker.bundle.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "OAAth"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*", "https://*/*"]
}
