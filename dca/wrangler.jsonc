{
  "$schema": "https://unpkg.com/wrangler@4.147.0/config-schema.json",
  "name": "oaath-dca",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-05",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "dca.taek.tech", "custom_domain": true }],
  // The Worker decides every route first; `/callback` maps to callback.html itself.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "DCA_ORIGIN": "https://dca.taek.tech",
    "OAATH_ISSUER": "https://oaath.taek.tech",
    // REPLACE: register with POST https://oaath.taek.tech/oauth/clients
    // (redirect_uris ["https://dca.taek.tech/callback"]) and put the returned id here.
    "OAATH_CLIENT_ID": "6982278824b7ebfa22dcbfd6a5feb1f41f8deab5",
    "EXPLORER_TX_URL": "https://sepolia.arbiscan.io/tx/",
    "CHAIN_RPC_URL": "https://sepolia-rollup.arbitrum.io/rpc",
    // The hosted automation service. The app stays off until the AUTOMATION_APP_TOKEN
    // secret holds this app's credential there.
    "AUTOMATION_URL": "https://oaath-automation.taek.tech",
    // Test tUSD (`contracts.token` of the dca.arbsep.* definitions). The bundler relays
    // only `mint(sender, 1000e6)` on it; re-set it when the market is redeployed.
    "TUSD_TOKEN": "0xa394869aaBEDb1A989614AA9c3dd41907C596E71"
  },
  // Bundler: bundle_rs in its default fast mode (zero-fee operations, its executor
  // pays gas), loopback-only on the VM, reached through a Workers VPC service. Without
  // the binding the bundler route answers 503 and the mint button stays hidden.
  "vpc_services": [
    {
      "binding": "BUNDLER",
      // Workers VPC service for bundle_rs: 127.0.0.1:4337 on the OCI VM's loopback.
      "service_id": "01a11b20-f2a5-7080-96a8-aca3de4fd906"
    }
  ],
  // Server-side calls to the hosted automation service go through its Worker directly.
  "services": [{ "binding": "AUTOMATION_SERVICE", "service": "oaath-automation" }],
  "ratelimits": [
    // Per IP: every proxied chain and bundler call, and session request.
    { "name": "RPC_LIMIT", "namespace_id": "4216160", "simple": { "limit": 300, "period": 60 } },
    // Per IP: eth_sendUserOperation (the tUSD mint).
    { "name": "SEND_LIMIT", "namespace_id": "4216161", "simple": { "limit": 3, "period": 60 } }
  ],
  "observability": { "enabled": true }
}
